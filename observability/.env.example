# .env.example — copier en `.env` (JAMAIS commité, cf. .gitignore racine) puis remplir.
#   cp .env.example .env

# Grafana — mot de passe du compte admin initial
GRAFANA_ADMIN_PASSWORD=changez-moi

# GlitchTip — mot de passe Postgres + clé secrète Django
GT_DB_PASSWORD=changez-moi
# Générer :  openssl rand -hex 32
GT_SECRET_KEY=

# NB : le webhook Slack d'Alertmanager n'est PAS une variable d'environnement
# (Alertmanager ne les lit pas) : créer le fichier
#   alertmanager/secrets/slack_webhook_url   (voir le .example à côté, hors Git)
