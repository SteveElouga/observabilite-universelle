# .env.example — copier en `.env` (JAMAIS commité, cf. .gitignore racine) puis remplir.
#   cp .env.example .env

# Grafana — mot de passe du compte admin initial
GRAFANA_ADMIN_PASSWORD=changez-moi

# GlitchTip — mot de passe Postgres + clé secrète Django
GT_DB_PASSWORD=changez-moi
# Générer :  openssl rand -hex 32
GT_SECRET_KEY=

# units-service (démo, profil « demo ») — clé secrète Django.
# Un défaut est fourni par le compose ; personnalisez-la si vous le souhaitez.
UNITS_SECRET_KEY=demo-insecure-change-me

# NB : le webhook Slack d'Alertmanager n'est PAS une variable d'environnement
# (Alertmanager ne les lit pas) : créer le fichier
#   alertmanager/secrets/slack_webhook_url   (voir le .example à côté, hors Git)

# Durcissement (hardening/, lot #9) — authentification basique Caddy pour l'accès direct
# optionnel aux backends (Prometheus/Alertmanager, blocs commentés dans hardening/Caddyfile).
# Sans effet sur Grafana/GlitchTip/Faro, qui ont leur propre authentification.
# BASIC_AUTH_USER a une valeur par défaut (admin) si absente ; BASIC_AUTH_HASH est vide par
# défaut, ce qui bloque tout accès (basic_auth sans hash valide refuse toutes les requêtes) —
# c'est le comportement recherché tant que l'accès direct n'est pas explicitement activé.
# Générer le hash :  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'votre-mot-de-passe'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# ── Alerting : livraison des notifications (corrigé le 14/09/2026) ───────────────────────
# Rien de ce bloc n'est obligatoire. Ce qui est renseigné est branché, ce qui ne l'est pas
# reste ABSENT de la configuration effective d'Alertmanager (alertmanager/render-config.sh) —
# et non déclaré-mais-cassé, qui était le défaut : un webhook dont le secret manquait faisait
# échouer 1 447 notifications en 72 h, en silence.
#
# Canal de secours par e-mail (indépendant de Slack et de sa résolution DNS). Les QUATRE
# variables ci-dessous ET le fichier alertmanager/secrets/smtp_password sont nécessaires :
# sinon aucun bloc e-mail n'est écrit.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USERNAME=

# Canaux Slack. Le premier reçoit les incidents (`page` et `ticket`), le second la DETTE
# D'INSTRUMENTATION (`dette`) : deux règles y déclarent un trou de surveillance et sont donc
# vraies en permanence — `SauvegardeJamaisDeclaree` et `SGFECronsNonInstrumentes`. Les laisser
# dans le canal d'incident les y faisait revenir toutes les 24 h ; elles n'y repassent plus, et
# ne se répètent qu'une fois par semaine.
#
# ⚠ Un webhook créé par une app Slack est LIÉ à son canal et ignore le champ `channel` (seuls
#   les webhooks « legacy custom integration » l'honorent). Pour séparer réellement les deux
#   canaux, créer un second webhook et le déposer dans
#   alertmanager/secrets/slack_webhook_dette_url ; sans lui, la dette part sur le webhook
#   principal, simplement beaucoup moins souvent.
ALERT_SLACK_CHANNEL=#alertes
ALERT_SLACK_CHANNEL_DETTE=#dette-technique

# Serveurs DNS amont du conteneur Alertmanager. Sur un réseau défini par l'utilisateur, le
# résolveur intégré de Docker (127.0.0.11) transfère les requêtes externes à ces serveurs ; la
# résolution des noms de services continue de fonctionner. Constaté sans ce réglage :
# « dial tcp: lookup hooks.slack.com on 127.0.0.11:53: no such host ». Remplacer par le
# résolveur du site si 1.1.1.1 est filtré.
ALERTMANAGER_DNS=1.1.1.1

# Environnement par DÉFAUT posé par le Collector sur la télémétrie qui n'en déclare aucun.
# Il n'écrase plus jamais la valeur envoyée par un SDK (processeur `resource`, action `insert`).
DEPLOY_ENV=prod

# ── Collecte des journaux : périmètre ────────────────────────────────────────────────────
# Expression régulière (ancrée) des projets Compose dont Alloy ingère les journaux.
#   .+                      → tout conteneur appartenant à un projet Compose (défaut)
#   sgfe-.*|observability   → uniquement les projets SGFE et la plateforme
# Sans restriction, `discovery.docker` ingérait les 84 conteneurs du démon, dont ceux d'autres
# projets clients, dans un Loki mono-tenant et sans authentification.
LOGS_COMPOSE_PROJECTS=.+

# ── Sondes du consommateur (Blackbox) ────────────────────────────────────────────────────
# Cibles HTTP de SGFE qui ne sont PAS sur le réseau partagé obs-edge (nginx, whatsapp-service).
# Format : « hôte:port/chemin » séparés par des espaces ; laisser vide pour n'en sonder aucune.
SGFE_PROBE_TARGETS=

# Passerelle GraphQL de SGFE, sondée par `{__typename}`. AUCUNE cible n'est active par défaut,
# ici non plus : là où le projet consommateur ne tourne pas sur obs-edge, une cible en dur fait
# sonner « ProbeDown » (severity=page) en permanence.
#
# Volontairement VIDE, y compris dans ce modèle : en mode image, l'entrypoint n'écrit la cible
# que si la variable est renseignée, donc un `.env` recopié tel quel l'activerait chez qui ne
# fait tourner que le socle — l'inverse exact de la règle « c'est l'ACTIVATION qui est
# explicite, jamais la désactivation ». Valeur à poser pour activer la sonde :
#     SGFE_GRAPHQL_TARGET=http://gateway:8000/graphql
# En mode compose, préférer le profil dédié : docker compose --profile sgfe up -d
SGFE_GRAPHQL_TARGET=
