{
  "uid": "sgfe-metier",
  "title": "SGFE — Métier",
  "description": "Facturation, encaissements, relances, parc d'abonnés : les compteurs métier réellement émis par les neuf composants SGFE.",
  "tags": [
    "sgfe",
    "metier"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
