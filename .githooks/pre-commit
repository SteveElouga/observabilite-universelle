#!/bin/sh
# Règles R2/R7 (README.md) : main et develop sont inviolables — aucun commit direct.
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
case "$branch" in
  main|develop)
    echo "" >&2
    echo "⛔ COMMIT REFUSÉ : la branche '$branch' est inviolable (règles R2/R13 — README.md)." >&2
    echo "   Créez une branche de travail :" >&2
    echo "     git checkout -b feature/<sujet> develop" >&2
    echo "" >&2
    exit 1
    ;;
esac
exit 0
